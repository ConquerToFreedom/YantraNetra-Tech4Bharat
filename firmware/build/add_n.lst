  53:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** };
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <>
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct FixedPointRawTypeTraits<std::int16_t> {
  57:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef std::int16_t ScalarRawType;
  58:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static constexpr int kLanes = 1;
  59:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** };
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns a value duplicating a scalar value across all lanes.
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType>
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tRawType Dup(typename FixedPointRawTypeTraits<tRawType>::ScalarRawType x) {
