  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Tensor value arithmetic helpers for ops where integer overflow is documented
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // numeric behavior and not used for memory allocation, indexing, shape
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // computation, or control-flow bounds. These intentionally preserve the direct
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // arithmetic expression and only suppress UBSan's integer-overflow diagnostic.
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Do not use these helpers for shape, element count, allocation, or pointer
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // offset arithmetic; those paths need checked integer helpers instead.
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** TFLITE_NO_SANITIZE_INTEGER_OVERFLOW inline T
  88:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** AddTensorValuesWithExpectedOverflow(T a, T b) {
  89:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   return a + b;
  90:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
  91:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
  92:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
  93:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** TFLITE_NO_SANITIZE_INTEGER_OVERFLOW inline T
