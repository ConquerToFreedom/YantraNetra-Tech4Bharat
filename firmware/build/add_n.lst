  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Part 1: Low-level integer-arithmetic primitives.
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The implementations here are generic implementations valid for
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // scalar types (e.g. std::int32_t, std::int16_t).
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The purpose of these primitives is two-fold:
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //  - They will be used to implement higher-level fixed-point
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    abstractions, namely the FixedPoint class and its arithmetic
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    operators.
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //  - They will be directly used to implement some more involved
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    fixed-point computations, e.g. the fixed-point implementation
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    of math functions such as tanh.
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Compile-time traits around raw types: number of lanes, underlying scalar
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // type.
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct FixedPointRawTypeTraits {};
