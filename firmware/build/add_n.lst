  67:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Plain bit-wise AND
  68:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  69:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType BitAnd(tIntegerType a, tIntegerType b) {
