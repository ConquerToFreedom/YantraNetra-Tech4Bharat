  89:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
  90:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  91:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer addition. Not saturating. Overflow is undefined behavior.
  92:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  93:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType Add(tIntegerType a, tIntegerType b) {
