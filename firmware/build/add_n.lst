  96:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  97:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer multiplication. Not saturating. Overflow is undefined behavior.
  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType Mul(tIntegerType a, tIntegerType b) {
 100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a * b;
 101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer subtraction. Not saturating. Overflow is undefined behavior.
 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType Sub(tIntegerType a, tIntegerType b) {
 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a - b;
