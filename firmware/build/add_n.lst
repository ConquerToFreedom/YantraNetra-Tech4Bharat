 108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer unary negative. Not saturating. Overflow is undefined behavior.
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType Neg(tIntegerType a) {
