 381:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // Perform a batch matrix multiply on
 382:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // LHS <..., A, B>  X  RHS<..., B, C>
 383:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // where the leading dimensions of LHS and RHS obey broadcasting rules
 384:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // (this Op will apply broadcasting rules).
 385:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // We assume that LHS and RHS are both row oriented (adjacent values in memory
 386:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // are in the same row) and will output in the same memory layout. However,
 387:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // our fast GEMM libraries assume RCC layout (LHS row oriented,
 388:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // RHS column oriented, output column oriented). Therefore, we perform
 389:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // RHS <..., C, B> X LHS <..., B, A>
 390:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // where output is a C X A column-oriented, which is equivalent to
 391:lib/tflite-micro/tensorflow/lite/micro/kernels/batch_matmul.cc **** // A X C row-oriented.
