  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/batch_matmul.h **** // Determine which dimension is the broadcast dimension.
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/batch_matmul.h **** inline int broadcast_dim(int lhs_dim, int rhs_dim) {
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/batch_matmul.h ****   if (lhs_dim == rhs_dim) return lhs_dim;
