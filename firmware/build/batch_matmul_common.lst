  15:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** #ifndef TENSORFLOW_LITE_MICRO_KERNELS_INTERNAL_REFERENCE_TRANSPOSE_H_
  16:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** #define TENSORFLOW_LITE_MICRO_KERNELS_INTERNAL_REFERENCE_TRANSPOSE_H_
  17:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
  18:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** #include <array>
  19:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
  20:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** #include "tensorflow/lite/micro/kernels/internal/types.h"
  21:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
  22:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** namespace tflite {
  23:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** namespace micro {
  24:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
  25:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** namespace reference_ops {
  26:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
  27:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** namespace transpose_internal {
  28:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
  29:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Recursively explores all the dimensions of the output tensor and writes the
  30:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // corresponding input tensor data.
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - depth: the current depth of the recursion.
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - dims: tensor dimension count, also `perm` size.
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - perm: permutation array.
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - input_data: Running input data pointer. If depth == num_dims-1, this points
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //               to the first element of the last dimension to traverse.
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - input_stride: Reverse partial product of input shapes.
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - output_data: Running output data pointer. If depth == num_dims-1, this
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //                points to the first element of the last dimension to traverse.
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - output_stride: Reverse partial product of output shapes.
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - output_shape: Shape of the output tensor.
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ## Algorithm explanation
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Assume a 3D tensor T with a shape of [I, J, K] stored in row major order.
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // T[i, j, k] is at position `i*J*K + j*K + k` in the tensor buffer.
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  48:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // If we want to go through the whole tensor iteratively, we can use loops.
  49:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // for(i = 0; i < I; ++i) {
