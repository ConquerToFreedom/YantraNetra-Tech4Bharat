 654:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // The size of the LUT depends on the type of input. For uint8 and int8 inputs a
 655:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // simple 256 entries LUT is used. For int16 inputs the high 9 bits are used for
 656:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // indexing and the 7 remaining bits are used for interpolation. We thus use a
 657:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // 513-entries LUT for int16 cases, 512 for the 9-bit indexing and 1 extra entry
 658:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // to interpolate the last value.
 659:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
 660:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** constexpr int LUTSize() {
 661:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   static_assert(std::is_same_v<T, uint8_t> || std::is_same_v<T, int8_t> ||
 662:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                     std::is_same_v<T, int16_t>,
 663:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                 "Only LUTs with uint8, int8 or int16 inputs are supported.");
 664:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   if constexpr (std::is_same_v<T, uint8_t> || std::is_same_v<T, int8_t>) {
 665:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return 256;
 666:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   } else {
 667:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return 513;
 668:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
 669:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
 670:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
 671:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // int16_t -> int16_t table lookup with interpolation
 672:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // LUT must have 513 values
 673:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline int16_t LUTLookup(int16_t value, const int16_t* lut) {
 674:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // 512 base values, lut[513] is only used to calculate the slope
 675:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   const uint16_t index = static_cast<uint16_t>(256 + (value >> 7));
