  40:lib/tflite-micro/tensorflow/lite/micro/kernels/cast.cc ****   TfLiteTensor* output =
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/cast.cc ****       micro_context->AllocateTempOutputTensor(node, kOutputTensor);
