 113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** //
 114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** //  1. If x is NaN, the result is nan_result, which defaults to zero.
 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** //
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** //  2. If the truncated form of x is above the representable range of IntOut,
