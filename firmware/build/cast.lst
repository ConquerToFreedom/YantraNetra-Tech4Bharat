 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** // truncated whenever that is representable as IntOut).
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** //
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.h **** // static_cast would cause undefined behavior for the following cases, which
