 187:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 188:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // For each pair of input scalars, the corresponding bits of the result are
 189:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // set if the input scalars a, b satisfy a >= b.
 190:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 191:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType MaskIfGreaterThanOrEqual(tIntegerType a, tIntegerType b) {
 192:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return MaskIfNonZero<tIntegerType>(a >= b);
