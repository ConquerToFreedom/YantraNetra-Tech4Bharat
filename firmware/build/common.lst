 184:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType MaskIfGreaterThan(tIntegerType a, tIntegerType b) {
 185:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return MaskIfNonZero<tIntegerType>(a > b);
