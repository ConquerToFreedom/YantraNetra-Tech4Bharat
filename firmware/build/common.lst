 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer arithmetic left-shift, equivalent to multiplying with a power of two.
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Negative values are OK. In case of overflow, no Undefined
 117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Behavior, but the results are implementation-defined (in practice,
 118:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // they currently are saturated, but we make no commitment to that). The idea
 119:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // is that the caller will want to implement the overflowing cases with
 120:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // saturation with compare-and-mask, so we don't care about the results
 121:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // in the overflow case, we just want to avoid undefined behavior.
 122:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 123:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // tIntegerType may be int32 or any narrower signed type.
 124:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 125:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType ShiftLeft(tIntegerType a, int offset) {
 126:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const std::int64_t wide_a = static_cast<std::int64_t>(a);
 127:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const std::int64_t wide_shifted = wide_a * (1 << offset);
 128:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const auto min = std::numeric_limits<tIntegerType>::min();
 129:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const auto max = std::numeric_limits<tIntegerType>::max();
 130:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return wide_shifted < min   ? min
 131:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****          : wide_shifted > max ? max
 132:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****                               : static_cast<tIntegerType>(wide_shifted);
 133:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 134:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 135:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer arithmetic right-shift. Not rounding.
 136:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Relying on implementation-defined, but in-practice-consistent,
 137:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // C++ compiler behavior.
 138:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 139:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType ShiftRight(tIntegerType a, int offset) {
 140:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a >> offset;
 141:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
