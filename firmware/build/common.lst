  23:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.cc **** // These MultiplyByQuantizedMultiplier overloads do not intentionally wrap, so
  24:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.cc **** // they deliberately do NOT use WrappingMul/WrappingAdd. Under their documented
  25:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.cc **** // input contract (asserted below) the arithmetic does not overflow; the
  26:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.cc **** // attribute only silences UBSan reports at the contract's boundaries. Using
  27:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.cc **** // wrapping here would be wrong -- it would mask a contract violation (a real
  28:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.cc **** // bug) instead of letting it surface.
