  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Part 1: Low-level integer-arithmetic primitives.
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The implementations here are generic implementations valid for
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // scalar types (e.g. std::int32_t, std::int16_t).
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The purpose of these primitives is two-fold:
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //  - They will be used to implement higher-level fixed-point
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    abstractions, namely the FixedPoint class and its arithmetic
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    operators.
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //  - They will be directly used to implement some more involved
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    fixed-point computations, e.g. the fixed-point implementation
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //    of math functions such as tanh.
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Compile-time traits around raw types: number of lanes, underlying scalar
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // type.
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct FixedPointRawTypeTraits {};
  48:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  49:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <>
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct FixedPointRawTypeTraits<std::int32_t> {
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef std::int32_t ScalarRawType;
  52:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static constexpr int kLanes = 1;
  53:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** };
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <>
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct FixedPointRawTypeTraits<std::int16_t> {
  57:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef std::int16_t ScalarRawType;
  58:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static constexpr int kLanes = 1;
  59:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** };
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns a value duplicating a scalar value across all lanes.
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType>
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tRawType Dup(typename FixedPointRawTypeTraits<tRawType>::ScalarRawType x) {
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return x;
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
  66:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  67:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Plain bit-wise AND
  68:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  69:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType BitAnd(tIntegerType a, tIntegerType b) {
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a & b;
  71:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
  72:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Plain bit-wise OR
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType BitOr(tIntegerType a, tIntegerType b) {
