 248:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Get array size, DCHECKing that the dim index is in range.
 249:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 250:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Note that this will be phased out with Dims<4>, since RuntimeShape::Dims()
 251:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // already performs this check.
 252:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** template <int N>
 253:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** int ArraySize(const Dims<N>& array, int index) {
