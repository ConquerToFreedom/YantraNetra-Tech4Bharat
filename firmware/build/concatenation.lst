 226:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Since tensors with '0' in their shape are valid in TF, these offset functions
 227:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // allow that as long as the corresponding index is also 0. It is upto the
 228:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // calling ops to ensure that they perform verification checks on tensor shapes
