 231:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline int Offset(const Dims<4>& dims, int i0, int i1, int i2, int i3) {
 232:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK((i0 == 0 && dims.sizes[0] == 0) ||
 233:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                 (i0 >= 0 && i0 < dims.sizes[0]));
 234:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK((i1 == 0 && dims.sizes[1] == 0) ||
 235:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                 (i1 >= 0 && i1 < dims.sizes[1]));
 236:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK((i2 == 0 && dims.sizes[2] == 0) ||
 237:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                 (i2 >= 0 && i2 < dims.sizes[2]));
 238:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK((i3 == 0 && dims.sizes[3] == 0) ||
 239:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                 (i3 >= 0 && i3 < dims.sizes[3]));
 240:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   return i0 * dims.strides[0] + i1 * dims.strides[1] + i2 * dims.strides[2] +
 241:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****          i3 * dims.strides[3];
 242:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** }
 243:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** 
 244:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline int Offset(const Dims<4>& dims, int* index) {
