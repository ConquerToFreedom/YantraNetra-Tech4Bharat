  45:lib/tflite-micro/tensorflow/lite/micro/kernels/concatenation.cc **** inline int CalculatePositiveAxis(int axis, const TfLiteTensor* output_tensor) {
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/concatenation.cc ****   if (axis >= 0) {
