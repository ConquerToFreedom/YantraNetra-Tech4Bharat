 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // Accumulate with 32 bits accumulator.
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // In the nudging process during model quantization, we force
 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // real value of 0.0 be represented by a quantized value. This
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // guarantees that the input_offset is a int8_t, even though
 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // it is represented using int32_t. int32_t += int8_t *
 107:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // (int8_t - int8_t) so the highest value we can get from each
 108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // accumulation is [-127, 127] * ([-128, 127] -
 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // [-128, 127]), which is [-32512, 32512]. log2(32512)
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // = 14.98, which means we can accumulate at least 2^16
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // multiplications without overflow. The accumulator is
 112:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // applied to a filter so the accumulation logic will hold as
 113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // long as the filter size (filter_y * filter_x * in_channel)
 114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // does not exceed 2^16, which is the case in all the models
 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // we have seen so far.
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // TODO(b/174275578): Add a check to make sure the
 117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/conv.h ****                 // accumulator depth is smaller than 2^16.
