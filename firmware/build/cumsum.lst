 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer arithmetic left-shift, equivalent to multiplying with a power of two.
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Negative values are OK. In case of overflow, no Undefined
 117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Behavior, but the results are implementation-defined (in practice,
 118:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // they currently are saturated, but we make no commitment to that). The idea
 119:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // is that the caller will want to implement the overflowing cases with
 120:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // saturation with compare-and-mask, so we don't care about the results
 121:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // in the overflow case, we just want to avoid undefined behavior.
 122:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 123:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // tIntegerType may be int32 or any narrower signed type.
