  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                          static_cast<P>(static_cast<U>(b))));
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   } else {
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return a * b;
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
