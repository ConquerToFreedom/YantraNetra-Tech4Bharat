 143:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Each bit of the result is set to the corresponding bit of either then_val or
 144:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // else_val depending on whether the corresponding bit of if_mask is set.
 145:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Equivalent to the VBSL instruction in ARM NEON.
