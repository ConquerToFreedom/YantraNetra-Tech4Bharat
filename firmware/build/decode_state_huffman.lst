  25:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // MicroProfiler creates a common way to gain fine-grained insight into runtime
  26:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // performance. Bottleck operators can be identified along with slow code
  27:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // sections. This can be used in conjunction with running the relevant micro
  28:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // benchmark to evaluate end-to-end performance.
  29:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** class MicroProfiler : public MicroProfilerInterface {
  30:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****  public:
