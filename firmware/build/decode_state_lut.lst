  25:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // MicroProfiler creates a common way to gain fine-grained insight into runtime
  26:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // performance. Bottleck operators can be identified along with slow code
  27:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // sections. This can be used in conjunction with running the relevant micro
  28:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** // benchmark to evaluate end-to-end performance.
  29:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** class MicroProfiler : public MicroProfilerInterface {
  30:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****  public:
  31:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   MicroProfiler() = default;
  32:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   virtual ~MicroProfiler() = default;
  33:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
  34:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // Marks the start of a new event and returns an event handle that can be used
  35:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // to mark the end of the event via EndEvent. The lifetime of the tag
  36:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // parameter must exceed that of the MicroProfiler.
  37:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   virtual uint32_t BeginEvent(const char* tag) override;
  38:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
  39:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // Marks the end of an event associated with event_handle. It is the
  40:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // responsibility of the caller to ensure than EndEvent is called once and
  41:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // only once per event_handle.
  42:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   //
  43:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // If EndEvent is called more than once for the same event_handle, the last
  44:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // call will be used as the end of event marker. If EndEvent is called 0 times
  45:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // for a particular event_handle, the duration of that event will be 0 ticks.
  46:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   virtual void EndEvent(uint32_t event_handle) override;
  47:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
  48:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // Clears all the events that have been currently profiled.
  49:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   void ClearEvents();
  50:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
  51:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // Returns the sum of the ticks taken across all the events. This number
  52:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // is only meaningful if all of the events are disjoint (the end time of
  53:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // event[i] <= start time of event[i+1]).
  54:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   uint32_t GetTotalTicks() const;
  55:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
  56:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // Prints the profiling information of each of the events in human readable
  57:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // form.
