  83:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   };
  84:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // In practice, the number of tags will be much lower than the number of
  85:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // events. But it is theoretically possible that each event to be unique and
  86:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // hence we allow total_ticks_per_tag to have kMaxEvents entries.
  87:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   TicksPerTag total_ticks_per_tag_[kMaxEvents] = {};
  88:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
  89:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   int FindExistingOrNextPosition(const char* tag_name);
  90:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
