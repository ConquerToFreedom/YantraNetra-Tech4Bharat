  72:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   // of times. Increase this number if you need more events.
  73:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h ****   static constexpr int kMaxEvents = 4096;
  74:lib/tflite-micro/tensorflow/lite/micro/micro_profiler.h **** 
