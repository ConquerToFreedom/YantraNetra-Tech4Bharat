  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // Accumulate with 32 bits accumulator.
  88:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // In the nudging process during model quantization, we force
  89:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // real value of 0.0 be represented by a quantized value. This
  90:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // guarantees that the input_offset is a int8_t, even though
  91:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // it is represented using int32_t. int32_t += int8_t *
  92:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // (int8_t - int8_t) so the highest value we can get from each
  93:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // accumulation is [-127, 127] * ([-128, 127] -
  94:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // [-128, 127]), which is [-32512, 32512]. log2(32512)
  95:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // = 14.98, which means we can accumulate at least 2^16
  96:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // multiplications without overflow. The accumulator is
  97:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // applied to a filter so the accumulation logic will hold as
  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // long as the filter size (filter_y * filter_x * in_channel)
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // does not exceed 2^16, which is the case in all the models
 100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // we have seen so far.
 101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // TODO(b/174275578): Add a check to make sure the
 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/depthwise_conv.h ****                   // accumulator depth is smaller than 2^16.
