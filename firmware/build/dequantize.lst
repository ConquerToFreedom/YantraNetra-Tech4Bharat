 198:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline size_t ReducedOutputOffset(const int num_dims, const int* dims,
 199:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                                   const int* index, const int num_axis,
 200:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                                   const int* axis) {
 201:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   if (num_dims == 0) {
 202:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     return 0;
 203:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   }
 204:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK(dims != nullptr);
 205:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK(index != nullptr);
 206:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   size_t offset = 0;
 207:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   for (int idx = 0; idx < num_dims; ++idx) {
 208:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     // if we need to skip this axis
 209:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     bool is_axis = false;
 210:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     if (axis != nullptr) {
 211:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       for (int axis_idx = 0; axis_idx < num_axis; ++axis_idx) {
 212:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****         if (idx == axis[axis_idx]) {
 213:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****           is_axis = true;
 214:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****           break;
 215:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****         }
 216:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       }
 217:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     }
 218:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     if (!is_axis) {
 219:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       offset = offset * static_cast<size_t>(dims[idx]) +
 220:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                static_cast<size_t>(index[idx]);
 221:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     }
 222:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   }
 223:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   return offset;
 224:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** }
