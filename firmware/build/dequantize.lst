 130:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Quantization parameters, determining the mapping of quantized values
 131:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // to real values (i.e. determining how quantized values are mathematically
 132:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // interpreted).
 133:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\cct9rrew.s 			page 14


 134:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // The correspondence is as follows:
 135:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 136:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //   real_value = scale * (quantized_value - zero_point);
 137:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 138:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // In other words, zero_point designates which quantized value corresponds to
 139:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // the real 0 value, and scale designates the difference between the real values
 140:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // corresponding to consecutive quantized values differing by 1.
 141:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** struct QuantizationParams {
 142:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   int32_t zero_point = 0;
 143:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   double scale = 0.0;
 144:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** };
 145:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** 
 146:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline bool operator==(const QuantizationParams& qp1,
 147:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                        const QuantizationParams& qp2) {
 148:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   return qp1.zero_point == qp2.zero_point && qp1.scale == qp2.scale;
 149:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** }
 150:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** 
 151:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Quantization parameters for each channel, determining the mapping of
 152:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // quantized values to real values. See QuantizationParams for a single set of
 153:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // parameters per tensor. This has one parameters set per each channel.
 154:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 155:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // The correspondence is as follows:
 156:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 157:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //   real_value = scale[channel] * (quantized_value - zero_point[channel]);
 158:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 159:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** struct PerChannelQuantizationParams {
 160:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // The following members typically point to the corresponding members of a
 161:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // TfLiteAffineQuantization struct.
 162:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   const float* scale;
 163:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   const int32_t* zero_point;
 164:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   int32_t quantized_dimension;
 165:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** };
