  58:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** 
  59:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // Object Detection model produces axis-aligned boxes in two formats:
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // BoxCorner represents the lower left corner (xmin, ymin) and
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // the upper right corner (xmax, ymax).
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // CenterSize represents the center (xcenter, ycenter), height and width.
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // BoxCornerEncoding and CenterSizeEncoding are related as follows:
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // ycenter = y / y_scale * anchor.h + anchor.y;
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // xcenter = x / x_scale * anchor.w + anchor.x;
  66:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // half_h = 0.5*exp(h/ h_scale)) * anchor.h;
  67:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // half_w = 0.5*exp(w / w_scale)) * anchor.w;
  68:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // ymin = ycenter - half_h
  69:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // ymax = ycenter + half_h
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // xmin = xcenter - half_w
  71:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // xmax = xcenter + half_w
  72:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** struct BoxCornerEncoding {
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float ymin;
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float xmin;
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float ymax;
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float xmax;
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** };
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** 
  79:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** struct CenterSizeEncoding {
  80:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float y;
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float x;
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float h;
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****   float w;
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** };
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** // We make sure that the memory allocations are contiguous with static_assert.
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc **** static_assert(sizeof(BoxCornerEncoding) == sizeof(float) * kNumCoordBox,
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/detection_postprocess.cc ****               "Size of BoxCornerEncoding is 4 float values");
