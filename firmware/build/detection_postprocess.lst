 190:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/util.h **** inline std::string IntToStringHex(int i, int xdigits) {
 191:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/util.h ****   FLATBUFFERS_ASSERT(i >= 0);
