  28:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** //
  29:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // For example, if sequence of dimensions of one input is
  30:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // ..., 1, 3, 1, 7, 9, 5,... and the other is ..., 2, 3, 1, 7, 1, 1, ...
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // we can consolidate these as
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // ..., 1, 3*7, 9*5, ... and 2, 3*7, 1.
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** //
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // The category is updated in the less-frequent case of shapes that are
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // not suited to a fivefold-loop broadcast.
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** //
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // Falls back to generic pattern when it does not know how to process properly.
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** //
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // Returns true iff there is some sort of broadcast, which includes five-fold
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/process_broadcast_shapes.h **** // patterns and falling back to generic broadcast.
