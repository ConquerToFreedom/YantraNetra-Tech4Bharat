 353:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Correctly-rounded-to-nearest division by a power-of-two.
 354:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Also known as a rounding arithmetic right shift.
