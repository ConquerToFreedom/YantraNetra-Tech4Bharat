 360:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType zero = Dup<IntegerType>(0);
 361:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType one = Dup<IntegerType>(1);
 362:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType remainder = BitAnd(x, mask);
 363:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType threshold =
