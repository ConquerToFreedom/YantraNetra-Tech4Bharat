  59:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     using U = std::make_unsigned_t<T>;
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     using P = std::common_type_t<U, unsigned int>;
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return static_cast<T>(static_cast<U>(static_cast<P>(static_cast<U>(a)) +
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                          static_cast<P>(static_cast<U>(b))));
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   } else {
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return a + b;
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
