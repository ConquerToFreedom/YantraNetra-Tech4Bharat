  63:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****         static_cast<int32_t>(rescaled + output->params.zero_point);
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****     data->table[static_cast<uint8_t>(static_cast<T>(val))] =
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****         static_cast<T>(std::clamp(quantized, minval, maxval));
