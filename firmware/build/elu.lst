  53:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc **** 
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****   const float inverse_scale = 1 / output->params.scale;
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****   int32_t maxval = std::numeric_limits<T>::max();
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****   int32_t minval = std::numeric_limits<T>::min();
  57:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****   for (int32_t val = minval; val <= maxval; ++val) {
