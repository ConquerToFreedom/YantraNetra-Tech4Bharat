  49:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****   if (sizeof(T) != 1) {
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****     MicroPrintf("Lookup table valid only for 8bit");
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/elu.cc ****     TFLITE_ABORT;
