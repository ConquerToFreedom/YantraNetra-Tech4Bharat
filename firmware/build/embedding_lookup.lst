  57:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // Helper methods to quantize arrays of floats to the desired format.
  58:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** //
  59:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // There are several key flavors of quantization in TfLite:
  60:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** //        asymmetric symmetric  per channel
  61:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // int8_t  |     X    |    X    |     X      |
  62:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // uint8_t |     X    |    X    |            |
  63:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // int16_t |     X    |         |            |
  64:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // int32_t |          |    X    |     X      |
  65:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** //
  66:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // The per-op quantization spec can be found here:
  67:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // https://www.tensorflow.org/lite/performance/quantization_spec
  68:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** template <typename T>
  69:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** void Quantize(const float* input, T* output, int num_elements, float scale,
  70:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****               int zero_point) {
  71:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   for (int i = 0; i < num_elements; i++) {
  72:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****     output[i] = FloatToQuantizedType<T>(input[i], scale, zero_point);
  73:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   }
  74:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** }
