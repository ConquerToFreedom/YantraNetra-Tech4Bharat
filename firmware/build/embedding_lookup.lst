  15:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** 
  16:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** // Ops that looks up items from matrix.
  17:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //
  18:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** // Input:
  19:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //     Tensor[0]: Row numbers to lookup, dim.size == 1, int32
  20:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //     Tensor[1]: 2-dimensional matrix of multi-dimensional items
  21:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //                dim.size >= 2, all items are INT8 or FLOAT32.
  22:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //                first dimension is row, second dimension is column.
  23:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //
  24:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** // Output:
  25:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //   Output.dim[0] == Tensor[0].dim[0], num of lookups
  26:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //   Output.dim[1] == Tensor[1].dim[1],  num of items per row
  27:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //   Each item in output is a raw bytes copy of the corresponding item in input,
  28:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //   or a dequantized value in the case of a INT8 input.
  29:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //   When indices are out of bound, the ops will not succeed.
  30:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** //
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** 
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/embedding_lookup.cc **** #include "tensorflow/lite/micro/kernels/internal/types.h"
