  35:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // Converts a float value into a quantized value.  Note that large values (close
  36:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // to max int and min int) may see significant error due to a lack of floating
  37:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** // point granularity for large values.
  38:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** template <typename T>
  39:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** T FloatToQuantizedType(const float value, const float scale, int zero_point) {
  40:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   int32_t result = round(value / scale) + zero_point;
  41:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   result = std::clamp<int32_t>(result, std::numeric_limits<T>::min(),
  42:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****                                std::numeric_limits<T>::max());
  43:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   return result;
  44:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** }
  45:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** 
  46:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** template <typename T>
  47:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** T FloatToSymmetricQuantizedType(const float value, const float scale) {
  48:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   // 64-bit values are required since 8x16 conv accumulates to int64, meaning
  49:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   // an int64 bias is required.
  50:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   std::int64_t result = round(value / scale);
  51:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   result = std::clamp<std::int64_t>(
  52:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****       result, static_cast<std::int64_t>(std::numeric_limits<T>::min()) + 1,
  53:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****       std::numeric_limits<T>::max());
  54:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   return result;
  55:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** }
