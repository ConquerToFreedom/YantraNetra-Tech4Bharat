  76:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** template <typename T>
  77:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h **** void SymmetricQuantize(const float* input, T* output, int num_elements,
  78:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****                        float scale) {
  79:lib/tflite-micro/tensorflow/lite/micro/micro_utils.h ****   for (int i = 0; i < num_elements; i++) {
