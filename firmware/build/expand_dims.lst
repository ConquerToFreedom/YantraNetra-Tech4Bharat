  52:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** // Verifies that the output tensor's dimension shape is equivalent to inserting
  53:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** // a dimension of length 1 at the dimension index axis of input's shape as
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** // defined in https://www.tensorflow.org/api_docs/python/tf/expand_dims.
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** TfLiteStatus VerifyTensorDim(TfLiteContext* context, const TfLiteTensor* input,
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****                              const TfLiteTensor* axis_tensor,
  57:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****                              const TfLiteTensor* output) {
  58:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   int32_t axis_value = 0;
  59:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   TF_LITE_ENSURE_OK(context,
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****                     GetAxisValueFromTensor(context, axis_tensor, &axis_value));
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** 
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   tflite::micro::RuntimeShape input_shape =
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****       tflite::micro::GetTensorShape(input);
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   if (axis_value < 0) {
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****     axis_value = input_shape.DimensionsCount() + 1 + axis_value;
  66:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   }
  67:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   TF_LITE_ENSURE(context, axis_value <= input_shape.DimensionsCount());
  68:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** 
  69:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   // TFLM only supports fixed dimension tensor and assumes that the output shape
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   // is fully specified in the model. As such, TFLM directly use the pointer to
  71:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   // the dimension array in the model buffer.
  72:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   tflite::micro::RuntimeShape output_shape =
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****       tflite::micro::GetTensorShape(output);
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** 
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   TF_LITE_ENSURE(context, output_shape.DimensionsCount() ==
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****                               input_shape.DimensionsCount() + 1);
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   for (int i = 0; i < output_shape.DimensionsCount(); ++i) {
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****     if (i < axis_value) {
  79:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****       TF_LITE_ENSURE(context, output_shape.Dims(i) == input_shape.Dims(i));
  80:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****     } else if (i == axis_value) {
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****       TF_LITE_ENSURE(context, output_shape.Dims(i) == 1);
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****     } else {
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****       TF_LITE_ENSURE(context, output_shape.Dims(i) == input_shape.Dims(i - 1));
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****     }
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   }
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc ****   return kTfLiteOk;
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/expand_dims.cc **** }
