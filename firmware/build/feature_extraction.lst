  11:App/feature_extraction.c **** void extract_features(const float *buffer, int size, float *features) {
  12:App/feature_extraction.c ****     if (buffer == 0 || features == 0 || size <= 0) return;
  13:App/feature_extraction.c **** 
  14:App/feature_extraction.c ****     float sum = 0.0f;
  15:App/feature_extraction.c ****     float sum_sq = 0.0f;
  16:App/feature_extraction.c ****     float min_val = buffer[0];
  17:App/feature_extraction.c ****     float max_val = buffer[0];
  18:App/feature_extraction.c **** 
  19:App/feature_extraction.c ****     for (int i = 0; i < size; i++) {
  20:App/feature_extraction.c ****         float x = buffer[i];
  21:App/feature_extraction.c ****         sum += x;
  22:App/feature_extraction.c ****         sum_sq += x * x;
  23:App/feature_extraction.c ****         if (x < min_val) min_val = x;
  24:App/feature_extraction.c ****         if (x > max_val) max_val = x;
  25:App/feature_extraction.c ****     }
  26:App/feature_extraction.c **** 
  27:App/feature_extraction.c ****     float mean = sum / (float)size;
  28:App/feature_extraction.c ****     float variance = (sum_sq / (float)size) - (mean * mean);
  29:App/feature_extraction.c ****     float rms = sqrtf(sum_sq / (float)size);
