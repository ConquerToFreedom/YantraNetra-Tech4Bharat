  42:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** // Utility class for safely allocating POD data. This is useful for avoiding
  43:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** // leaks in cases where op params are allocated but fail to propagate to the
  44:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** // parsed op data (e.g., when model parameters are invalid).
  45:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** class SafeBuiltinDataAllocator {
  46:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****  public:
  47:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****   class BuiltinDataDeleter {
  48:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****    public:
  49:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****     explicit BuiltinDataDeleter(BuiltinDataAllocator* allocator)
  50:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****         : allocator_(allocator) {}
  51:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** 
  52:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****     void operator()(void* data) { allocator_->Deallocate(data); }
  53:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** 
  54:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****    private:
  55:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****     BuiltinDataAllocator* allocator_;
  56:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****   };
  57:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** 
  58:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****   template <typename T>
  59:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****   using BuiltinDataPtr = std::unique_ptr<T, BuiltinDataDeleter>;
  60:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** 
  61:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****   explicit SafeBuiltinDataAllocator(BuiltinDataAllocator* allocator)
  62:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****       : allocator_(allocator) {}
  63:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc **** 
  64:lib/tflite-micro/tensorflow/lite/micro/flatbuffer_conversions.cc ****   template <typename T>
