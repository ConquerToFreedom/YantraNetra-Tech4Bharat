  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     // The next loop's stride must match the current loop's stride.
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     return stride == expected_stride;
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   }
