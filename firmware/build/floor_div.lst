  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h **** // dimension in the loop nest.
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h **** inline bool CanFuseLoops(size_t output_dim, size_t dim, size_t stride,
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****                          size_t expected_stride, size_t next_stride) {
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   if (output_dim == 1) {
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     // We can always fuse an extent 1 dimension.
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     return true;
