 167:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Gets next index to iterate through a multidimensional array.
 168:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** template <typename IndexType = int>
 169:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline bool NextIndex(const int num_dims, const int* dims, IndexType* current) {
 170:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   if (num_dims == 0) {
 171:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     return false;
 172:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   }
 173:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK(dims != nullptr);
 174:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK(current != nullptr);
 175:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   for (int i = 0; i < num_dims; ++i) {
 176:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     TFLITE_DCHECK_GE(dims[i], 0);
 177:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   }
 178:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   int carry = 1;
 179:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   for (int idx = num_dims - 1; idx >= 0; --idx) {
 180:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     IndexType current_val = current[idx] + carry;
 181:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     if (current_val >= dims[idx]) {
 182:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       current[idx] = 0;
 183:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     } else {
 184:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       current[idx] = current_val;
 185:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       carry = 0;
 186:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       break;
 187:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     }
 188:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   }
 189:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   return (carry == 0);
 190:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** }
