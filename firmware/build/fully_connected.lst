  28:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // For per-channel functions, since it is defined in quantization spec that
  29:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // weights are symmetric
  30:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // (https://www.tensorflow.org/lite/performance/quantization_spec#symmetric_vs_asymmetric),
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // zero_point (params.weights_offset) is always 0.
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // However, for per-tensor functions, params.weights_offset is still applied for
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // backward compatibility.
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** template <typename InputType, typename WeightType, typename OutputType,
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h ****           typename BiasType>
