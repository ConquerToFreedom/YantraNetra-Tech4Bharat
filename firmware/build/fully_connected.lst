  69:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // This enumeration allows for non-default formats for the weights array
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // of a fully-connected operator, allowing the use of special optimized
