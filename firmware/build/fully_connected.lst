  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // This implementation receives the scales in float and performs requant in
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** // float to avoid loss of precision.
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** template <typename InputType, typename WeightType, typename OutputType,
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h ****           typename BiasType>
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h **** void FullyConnectedPerChannel(
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h ****     const FullyConnectedParams& params, const RuntimeShape& input_shape,
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h ****     const InputType* input_data, const RuntimeShape& filter_shape,
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h ****     const WeightType* filter_data, const RuntimeShape& bias_shape,
  88:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/integer_ops/fully_connected.h ****     const BiasType* bias_data, const RuntimeShape& output_shape,
