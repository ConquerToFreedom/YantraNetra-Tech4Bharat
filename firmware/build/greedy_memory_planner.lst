  24:lib/tflite-micro/tensorflow/lite/micro/memory_planner/micro_memory_planner.h **** // Interface class for planning the layout of memory buffers during the
  25:lib/tflite-micro/tensorflow/lite/micro/memory_planner/micro_memory_planner.h **** // execution of a graph.
