  22:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** namespace tflite {
  23:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** namespace micro {
  24:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** 
  25:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** constexpr int kOnlinePlannedBuffer = -1;
  26:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** 
  27:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** // A memory planner that uses a greedy algorithm to arrange buffers in memory
  28:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** // to minimize the overall arena size needed.
  29:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //
  30:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** // The algorithm works like this:
  31:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - The client enters the buffer information through AddBuffer().
  32:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - When a function like GetOffsetForBuffer() is called, the
  33:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //    CalculateOffsetsIfNeeded() method is invoked.
  34:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - If an up to date plan is not already present, one will be calculated.
  35:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - The buffers are sorted in descending order of size.
  36:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - The largest buffer is placed at offset zero.
  37:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - The rest of the buffers are looped through in descending size order.
  38:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - The other buffers that need to be in memory at the same time are found.
  39:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - The first gap between simultaneously active buffers that the current
  40:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //    buffer fits into will be used.
  41:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - If no large-enough gap is found, the current buffer is placed after the
  42:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //    last buffer that's simultaneously active.
  43:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //  - This continues until all buffers are placed, and the offsets stored.
  44:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** //
  45:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** // This is not guaranteed to produce the best placement, since that's an
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\cchRkzbd.s 			page 5


  46:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** // NP-Complete problem, but in practice it should produce one that's decent.
  47:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** class GreedyMemoryPlanner : public MicroMemoryPlanner {
  48:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h ****  public:
  49:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h ****   GreedyMemoryPlanner();
  50:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h ****   ~GreedyMemoryPlanner() override;
  51:lib/tflite-micro/tensorflow/lite/micro/memory_planner/greedy_memory_planner.h **** 
