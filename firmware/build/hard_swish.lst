  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // by the quantized value 32768.  (+32768 is actually not representable as
  88:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // int16_t, so this saturates at +32767, and that is seen empirically to be
  89:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // a negligible contribution to numerical error/bias).
  90:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     //
  91:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // This code is careful to correctly implement any magnitude of multiplier,
  92:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // involving either a right shift or a left shift, with correct saturation
  93:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // behavior in the left-shift case. This forces this code to be more
  94:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // complicated, but is necessary for real applications: a partially
  95:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // trained quantized MobileNet v3-small model that motivated this code
  96:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // exhibits some large [min, max] range boundaries, of the order of
  97:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // magnitude of 10 or 100 depending on layers.
  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     //
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // The next few lines are basically just an ordinary
 100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // MultiplyByQuantizedMultiplier, except that we are more careful here
 101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // about the fine details of saturation when left-shifting, because here
 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // overflow in left-shift is a common case, not an anomaly as
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // MultiplyByQuantizedMultiplier assumes.
 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     int16_t reluish_value = input_value_on_hires_input_scale;
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // Shift left, saturating, as much as we can while ensuring that this
 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/hard_swish.h ****     // saturation will not contribute to the result. That is, left shift amount
