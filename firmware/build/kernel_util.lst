 453:lib/tflite-micro/tensorflow/lite/micro/kernels/kernel_util.cc ****   const double input_product_scale = static_cast<double>(input->params.scale) *
 454:lib/tflite-micro/tensorflow/lite/micro/kernels/kernel_util.cc ****                                      static_cast<double>(filter->params.scale);
 455:lib/tflite-micro/tensorflow/lite/micro/kernels/kernel_util.cc ****   // The following conditions must be guaranteed by the training pipeline.
 456:lib/tflite-micro/tensorflow/lite/micro/kernels/kernel_util.cc ****   if (bias) {
 457:lib/tflite-micro/tensorflow/lite/micro/kernels/kernel_util.cc ****     const double bias_scale = static_cast<double>(bias->params.scale);
 458:lib/tflite-micro/tensorflow/lite/micro/kernels/kernel_util.cc ****     // Here we're making sure the input_product_scale & bias_scale are about the
