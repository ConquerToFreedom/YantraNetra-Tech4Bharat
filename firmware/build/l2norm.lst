 157:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a ? BitNot(zero) : zero;
 158:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
