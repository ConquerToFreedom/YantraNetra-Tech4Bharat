 548:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int tExponent, typename tRawType, int tIntegerBits>
 549:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tIntegerBits> SaturatingRoundingMultiplyByPOT(
