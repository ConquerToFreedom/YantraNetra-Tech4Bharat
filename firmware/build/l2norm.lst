 537:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Tweaking IntegerBits gives exact multiplication by a power of two.
 538:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int tExponent, typename tRawType, int tIntegerBits>
 539:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tExponent + tIntegerBits> ExactMulByPot(
 540:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, tIntegerBits> a) {
 541:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   FixedPoint<tRawType, tExponent + tIntegerBits> c;
 542:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   c.raw() = a.raw();
 543:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return c;
 544:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
