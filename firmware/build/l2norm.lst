 290:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns the integer that represents the product of two fixed-point
 291:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // numbers, interpreting all integers as fixed-point values in the
 292:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // interval [-1, 1), rounding to the nearest value, and saturating
 293:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // -1 * -1 to the maximum value (since 1 is not in the half-open
 294:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // interval [-1, 1)).
 295:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 296:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // [The explanation below specializes to std::int32_t for example purpose.]
 297:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 298:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The mapping between IntegerType and the interval [-1, 1) is unique and
 299:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // implied by IntegerType, which is assumed to be signed. For example,
 300:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // for IntegerType==std::int32_t, the mapping is
 301:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   real_value = integer_value / 2^31.
 302:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // So in this case, and leaving aside rounding and saturating, this
 303:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // function computes ((a / 2^31) * (b / 2^31)) * 2^31, which simplifies to
 304:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   (a * b) / 2^31.
 305:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 306:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The 'doubling' part in the name of this function comes from the fact that
 307:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // this operation is very close to a "multiply-high" operation, keeping only
 308:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // the top half bits, except that that would be effectively computing
 309:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   (a * b) / 2^32,
 310:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // so here we are computing 2x that, since
 311:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   1/2^31 = 2 * 1/2^32.
 312:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The idea is to use all of the available 32 bits in the destination int32
 313:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // value.
 314:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 315:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // [End of the explanation specializing to int32.]
 316:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 317:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // This is equivalent to the VQRDMULH instruction in ARM NEON.
 318:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename IntegerType>
 319:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** IntegerType SaturatingRoundingDoublingHighMul(IntegerType a, IntegerType b) {
 320:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static_assert(std::is_same<IntegerType, void>::value, "unimplemented");
 321:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   (void)b;
 322:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a;
 323:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 324:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 325:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // This function implements the same computation as the ARMv7 NEON VQRDMULH
 326:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // instruction.
 327:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <>
 328:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** inline std::int32_t SaturatingRoundingDoublingHighMul(std::int32_t a,
 329:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****                                                       std::int32_t b) {
