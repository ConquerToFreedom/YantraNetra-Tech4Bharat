 695:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline int8_t LUTLookup(int8_t value, const int8_t* lut) {
 696:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   return lut[static_cast<uint8_t>(value)];
 697:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
