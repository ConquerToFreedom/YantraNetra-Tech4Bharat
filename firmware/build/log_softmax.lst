 180:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 181:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // For each pair of input scalars, the corresponding bits of the result are
