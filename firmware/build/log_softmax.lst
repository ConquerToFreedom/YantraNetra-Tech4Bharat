 815:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns tanh(x) for any x.
 816:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType, int tIntegerBits>
 817:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, 0> tanh(FixedPoint<tRawType, tIntegerBits> a) {
 818:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef FixedPoint<tRawType, tIntegerBits> InputF;
 819:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef FixedPoint<tRawType, 0> ResultF;
 820:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   tRawType mask_if_negative = MaskIfLessThan(a, InputF::Zero());
 821:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   tRawType mask_if_zero = MaskIfZero(a);
 822:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   InputF n = SelectUsingMask(mask_if_negative, a, -a);
 823:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   ResultF t = neg_tanh_on_negative_values(n);
 824:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return SelectUsingMask(mask_if_zero, ResultF::Zero(),
 825:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****                          SelectUsingMask(mask_if_negative, -t, t));
 826:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
