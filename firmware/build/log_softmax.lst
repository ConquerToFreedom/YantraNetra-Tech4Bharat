 143:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Each bit of the result is set to the corresponding bit of either then_val or
 144:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // else_val depending on whether the corresponding bit of if_mask is set.
 145:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Equivalent to the VBSL instruction in ARM NEON.
 146:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 147:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType SelectUsingMask(tIntegerType if_mask, tIntegerType then_val,
 148:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****                              tIntegerType else_val) {
 149:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return BitXor(BitAnd(if_mask, then_val), BitAnd(BitNot(if_mask), else_val));
 150:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 151:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 152:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // For each input scalar, the corresponding bits of the result are set if the
 153:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // input scalar is non-zero.
 154:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 155:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType MaskIfNonZero(tIntegerType a) {
 156:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static constexpr tIntegerType zero = 0;
 157:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return a ? BitNot(zero) : zero;
 158:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 159:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 160:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // For each input scalar, the corresponding bits of the result are set if the
 161:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // input scalar is zero.
 162:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 163:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType MaskIfZero(tIntegerType a) {
 164:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return MaskIfNonZero<tIntegerType>(!a);
 165:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 166:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 167:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // For each pair of input scalars, the corresponding bits of the result are
 168:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // set if the input scalars are equal.
 169:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 170:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType MaskIfEqual(tIntegerType a, tIntegerType b) {
 171:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return MaskIfNonZero<tIntegerType>(a == b);
 172:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 173:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 174:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // For each pair of input scalars, the corresponding bits of the result are
 175:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // set if the input scalars are not equal.
