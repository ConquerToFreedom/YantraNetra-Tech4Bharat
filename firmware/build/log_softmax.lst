 666:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // CheckedFixedPointConstant allows to specify fixed-point constants
 667:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // initialized as real numbers, in a way that does not compile floating-point
 668:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // arithmetic in production code, yet still checks agreement with the
 669:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // floating-point expressions when asserts are enabled.
 670:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 671:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The raw integer value provided is always a int32, encoding a 32-bit
 672:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // fixed-point value, regardless of the actual Scalar type. This allows
 673:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // writing generic code that applies just as well to the 32-bit and 16-bit
 674:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // cases. In the 16-bit case, the raw integer value is internally
 675:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // rounding-shifted by 16 bits to the right.
 676:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename FixedPointType>
 677:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** inline typename FixedPointType::ScalarRawType RescaleConstantInitializer(
 678:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     std::int32_t int32_value) {
 679:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef typename FixedPointType::ScalarRawType ScalarRawType;
 680:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static constexpr int ScalarTypeBits = 8 * sizeof(ScalarRawType);
 681:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return static_cast<ScalarRawType>(
 682:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****       RoundingDivideByPOT<std::int32_t>(int32_value, 32 - ScalarTypeBits));
 683:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
