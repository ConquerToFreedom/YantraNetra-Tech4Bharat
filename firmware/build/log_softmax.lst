 851:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Minimum output bits to accommodate log of maximum input range.  It actually
 852:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // does not matter if one considers, say, [-64,64] or [-64,64).
 853:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
 854:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // For example, run this through Octave:
 855:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // [0:127; ...
 856:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //  ceil(log(abs( log(2.^(0:127))+1 ))/log(2)); ...
 857:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //  ceil(log(abs( log(2.^(0:127))+1 ))/log(2))]
 858:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** constexpr int min_log_x_output_bits(int input_bits) {
 859:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   return input_bits > 90   ? 7
 860:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****          : input_bits > 44 ? 6
 861:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****          : input_bits > 21 ? 5
 862:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****          : input_bits > 10 ? 4
 863:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****          : input_bits > 4  ? 3
 864:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****          : input_bits > 1  ? 2
 865:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                            : 1;
 866:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
 867:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
 868:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Although currently the name of this function says that it cannot handle
 869:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // values less than 1, in practice it can handle as low as 1/x_max, where
 870:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // x_max is the largest representable input.  In other words, the output range
