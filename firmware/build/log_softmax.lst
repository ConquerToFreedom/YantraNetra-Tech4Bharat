 807:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns -tanh(x) for x < 0.
 808:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType, int tIntegerBits>
 809:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, 0> neg_tanh_on_negative_values(
 810:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, tIntegerBits> a) {
