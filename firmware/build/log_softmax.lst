 781:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Implementation of tanh: (1 - exp(-2x)) / (1 + exp(-2x)).
 782:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 783:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns (1 - x) / (1 + x) for x in (0, 1).
 784:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType>
 785:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, 0> one_minus_x_over_one_plus_x_for_x_in_0_1(
 786:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, 0> a) {
 787:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef FixedPoint<tRawType, 0> F0;
 788:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef FixedPoint<tRawType, 2> F2;
 789:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   F0 half_denominator = RoundingHalfSum(a, F0::One());
 790:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   // Newton-Raphson division
 791:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   // https://en.wikipedia.org/wiki/Division_algorithm#Newton.E2.80.93Raphson_division
 792:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   // Refer to that page for the logic behind the 48/17 and 32/17 constants.
 793:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const F2 constant_48_over_17 =
 794:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****       TFLITE_MICRO_CHECKED_FIXEDPOINT_CONSTANT(F2, 1515870810, 48.0 / 17.0);
 795:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const F2 constant_neg_32_over_17 =
 796:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****       TFLITE_MICRO_CHECKED_FIXEDPOINT_CONSTANT(F2, -1010580540, -32.0 / 17.0);
 797:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   F2 x = constant_48_over_17 + half_denominator * constant_neg_32_over_17;
 798:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   for (int i = 0; i < 3; i++) {
 799:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     F2 half_denominator_times_x = half_denominator * x;
 800:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     F2 one_minus_half_denominator_times_x =
 801:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         F2::One() - half_denominator_times_x;
 802:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     x = x + Rescale<2>(x * one_minus_half_denominator_times_x);
 803:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   }
 804:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return Rescale<0>(x - F2::One());
