 701:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline uint8_t LUTLookup(uint8_t value, const uint8_t* lut) {
 702:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   return lut[value];
 703:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
