 174:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK(current != nullptr);
 175:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   for (int i = 0; i < num_dims; ++i) {
