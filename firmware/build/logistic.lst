 544:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 545:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 546:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // If we want to leave IntegerBits fixed, then multiplication
 547:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // by a power of two has to be saturating/rounding, not exact anymore.
 548:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int tExponent, typename tRawType, int tIntegerBits>
 549:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tIntegerBits> SaturatingRoundingMultiplyByPOT(
