 353:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Correctly-rounded-to-nearest division by a power-of-two.
 354:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Also known as a rounding arithmetic right shift.
 355:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename IntegerType>
 356:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** inline IntegerType RoundingDivideByPOT(IntegerType x, int exponent) {
 357:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   assert(exponent >= 0);
 358:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   assert(exponent <= 31);
 359:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType mask = Dup<IntegerType>((1ll << exponent) - 1);
 360:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType zero = Dup<IntegerType>(0);
 361:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType one = Dup<IntegerType>(1);
 362:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType remainder = BitAnd(x, mask);
 363:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const IntegerType threshold =
 364:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****       Add(ShiftRight(mask, 1), BitAnd(MaskIfLessThan(x, zero), one));
 365:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return Add(ShiftRight(x, exponent),
 366:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****              BitAnd(MaskIfGreaterThan(remainder, threshold), one));
 367:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
