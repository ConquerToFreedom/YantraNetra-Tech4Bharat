 234:Core/Src/main.c ****     
 235:Core/Src/main.c ****     // 2. Simulate Sensor Readings
 236:Core/Src/main.c ****     float sim_temp = 25.0f;
 237:Core/Src/main.c ****     float sim_current = 1.5f; 
 238:Core/Src/main.c ****     float sim_voltage = 12.0f;
 239:Core/Src/main.c ****     
 240:Core/Src/main.c ****     // 3. AUTOMATIC FAULT INJECTION: Every 3rd loop, spike the current to 3.0A!
 241:Core/Src/main.c ****     if ((loop_count / 3) % 2 == 1) {
 242:Core/Src/main.c ****         sim_current = 3.0f; 
 243:Core/Src/main.c ****     }
