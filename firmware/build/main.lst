 248:Core/Src/main.c ****     
 249:Core/Src/main.c ****     // 5. Print the Anomaly Score
 250:Core/Src/main.c ****     printf("Inputs -> T:%.1f, C:%.1f, V:%.1f | MSE: %.5f | ", 
 251:Core/Src/main.c ****            sim_temp, sim_current, sim_voltage, mse_score);
 252:Core/Src/main.c ****            
 253:Core/Src/main.c ****     // 6. Check against Threshold
 254:Core/Src/main.c ****     if (mse_score > ANOMALY_MSE_THRESHOLD) {
 255:Core/Src/main.c ****         printf("STATE: CRITICAL (Fault Detected!)\r\n");
 256:Core/Src/main.c ****     } else {
