  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   if (next_stride == 0) {
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     // The next loop's stride is 0, the current stride must be 0 too.
