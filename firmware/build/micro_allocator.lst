 195:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     const tflite::Tensor& flatbuffer_tensor,
 196:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     const flatbuffers::Vector<flatbuffers::Offset<Buffer>>* buffers) {
 197:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // We need to figure out where the actual contents of this tensor are stored
 198:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // in memory. We'll check to see if there's a serialized buffer (pretty much
 199:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // the same as a constant op in TensorFlow) associated with this tensor first,
 200:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // and if there is update the runtime structure to point to its location in
 201:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // memory.
 202:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // First see if there's any buffer information in the serialized tensor.
 203:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   // TODO(b/170379532): Add better unit tests to validate flatbuffer values.
 204:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   void* out_buffer = nullptr;
 205:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   if (auto* buffer = (*buffers)[flatbuffer_tensor.buffer()]) {
 206:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     // If we've found a buffer, does it have any data?
 207:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     if (auto* array = buffer->data()) {
 208:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****       // If it has any data, is the data size larger than zero?
 209:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****       if (array->size()) {
 210:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****         // We've found a buffer with valid data, so update the runtime tensor
 211:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****         // data structure to point to it.
 212:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****         out_buffer = const_cast<void*>(static_cast<const void*>(array->data()));
 213:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****       }
 214:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     }
 215:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     // TODO(petewarden): It's not clear in what circumstances we could have a
 216:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     // buffer in the serialized tensor, but it doesn't have any data in it. Is
 217:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     // that a validly-generated file, and if so what does it mean, or is it an
 218:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     // error condition? It would be good to tighten up the specification to make
 219:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****     // it less ambiguous.
 220:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   }
 221:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc ****   return out_buffer;
 222:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.cc **** }
