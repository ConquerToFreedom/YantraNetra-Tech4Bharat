 325:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/base.h **** // Our default offset / size type, 32bit on purpose on 64bit systems.
 326:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/base.h **** // Also, using a consistent offset type maintains compatibility of serialized
 327:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/base.h **** // offset values between 32bit and 64bit systems.
 328:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/base.h **** typedef uint32_t uoffset_t;
