 349:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/base.h **** #define FLATBUFFERS_MIN_BUFFER_SIZE sizeof(::flatbuffers::uoffset_t) + \
 350:lib/tflite-micro/third_party/flatbuffers/include/flatbuffers/base.h ****   sizeof(::flatbuffers::soffset_t) + sizeof(uint16_t) + sizeof(uint16_t)
