 105:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // Allocator responsible for allocating memory for all intermediate tensors
 106:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // necessary to invoke a model.
 107:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** //
 108:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // The lifetime of the model, tensor arena and error reporter must be at
 109:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // least as long as that of the allocator object, since the allocator needs
 110:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // them to be accessible during its entire lifetime.
 111:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** //
 112:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // The MicroAllocator simply plans out additional allocations that are required
 113:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // to standup a model for inference in TF Micro. This class currently relies on
 114:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // an additional allocator - SingleArenaBufferAllocator - for all allocations
 115:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // from an arena. These allocations are divided into head (non-persistent) and
 116:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // tail (persistent) regions:
 117:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** //
 118:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // Memory layout to help understand how it works
 119:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // This information could change in the future version.
 120:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // ************** .memory_allocator->GetBuffer()
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\cc0Yihns.s 			page 15


 121:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // Tensors/Scratch buffers (head)
 122:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // ************** .head_watermark
 123:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // unused memory
 124:lib/tflite-micro/tensorflow/lite/micro/micro_allocator.h **** // ************** .memory_allocator->GetBuffer() + ->GetMaxBufferSize()
