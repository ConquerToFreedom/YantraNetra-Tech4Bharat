  16:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // Reference implementation of timer functions.  Platforms are not required to
  17:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // implement these timer methods, but they are required to enable profiling.
  18:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** 
  19:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // On platforms that have a POSIX stack or C library, it can be written using
  20:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // methods from <sys/time.h> or clock() from <time.h>.
  21:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** 
  22:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // To add an equivalent function for your own platform, create your own
  23:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // implementation file, and place it in a subfolder with named after the OS
  24:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // you're targeting. For example, see the Cortex M bare metal version in
  25:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** // tensorflow/lite/micro/bluepill/micro_time.cc
  26:lib/tflite-micro/tensorflow/lite/micro/micro_time.cc **** 
