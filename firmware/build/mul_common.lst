  61:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return static_cast<T>(static_cast<U>(static_cast<P>(static_cast<U>(a)) +
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                          static_cast<P>(static_cast<U>(b))));
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   } else {
