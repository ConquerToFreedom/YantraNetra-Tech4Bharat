  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Well-defined wrapping integer arithmetic helpers.
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Several elementwise/reduction kernels intentionally allow their value
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // arithmetic to wrap around for narrow integer types (the result is later
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // clamped, or wrapping is the documented behavior). Performing that wrap
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // directly on signed types is Undefined Behavior in C++, which the optimizer is
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // free to miscompile. These helpers instead perform the arithmetic in the
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // corresponding unsigned type -- where wrapping is fully defined -- and convert
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // the result back, so there is no UB even in optimized release builds.
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // For floating-point T these are plain a+b / a*b (no overflow concern); the
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // unsigned path is only taken for integral types.
  48:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
  49:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Note on integral promotion: for integer types narrower than int (e.g.
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // int16_t), the corresponding unsigned type (uint16_t) is still promoted to the
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // signed `int` before the arithmetic is performed. That promotion would
  52:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // reintroduce signed overflow UB (e.g. 65535 * 65535 overflows int). To avoid
  53:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // it we widen the operands to an unsigned type at least as wide as unsigned int
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // so the arithmetic itself stays unsigned, then truncate back down to the
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // narrow type -- both steps are well-defined.
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
