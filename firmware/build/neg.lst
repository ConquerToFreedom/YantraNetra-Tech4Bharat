 133:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 134:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // The correspondence is as follows:
 135:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
 136:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //   real_value = scale * (quantized_value - zero_point);
 137:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** //
