 167:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Gets next index to iterate through a multidimensional array.
 168:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** template <typename IndexType = int>
 169:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline bool NextIndex(const int num_dims, const int* dims, IndexType* current) {
 170:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   if (num_dims == 0) {
 171:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     return false;
