 177:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   }
 178:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   int carry = 1;
 179:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   for (int idx = num_dims - 1; idx >= 0; --idx) {
 180:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     IndexType current_val = current[idx] + carry;
 181:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     if (current_val >= dims[idx]) {
 182:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****       current[idx] = 0;
 183:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****     } else {
