  23:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** namespace tflite {
  24:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** namespace micro {
  25:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // Interface classes that the TFLM framework relies on to get buffers it needs.
  26:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // There are two types of buffers that the TFLM framework requires: persistent
  27:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // and non-persistent. Persistent buffers, once allocated, are never freed by
  28:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // the TFLM framework. Non-persist buffers can be allocated and deallocated by
  29:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // the TFLM framework. This file defines two interfaces classes that TFLM
  30:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // framework will rely on to manage these buffers.
  31:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** 
  32:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** // Interface class for managing persistent buffers.
  33:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** class IPersistentBufferAllocator {
  34:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****  public:
  35:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****   IPersistentBufferAllocator() {}
  36:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****   virtual ~IPersistentBufferAllocator() {}
  37:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** 
  38:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****   // Allocates persistent memory. The persistent buffer is never freed.
  39:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****   virtual uint8_t* AllocatePersistentBuffer(size_t size, size_t alignment) = 0;
  40:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** 
  41:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****   // Returns the size of all persistent allocations in bytes.
  42:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h ****   virtual size_t GetPersistentUsedBytes() const = 0;
  43:lib/tflite-micro/tensorflow/lite/micro/arena_allocator/ibuffer_allocator.h **** };
