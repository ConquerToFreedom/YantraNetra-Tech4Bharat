  28:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // TFLite Pad supports activation tensors with up to 5 dimensions.
  29:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** constexpr int PadKernelMaxDimensionCount() { return 5; }
  30:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** 
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // There are two versions of pad: Pad and PadV2.  In PadV2 there is a second
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // scalar input that provides the padding value.  Therefore pad_value_ptr can be
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // equivalent to a simple input1_data.  For Pad, it should point to a zero
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // value.
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** //
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // Note that two typenames are required, so that T=P=int32_t is considered a
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** // specialization distinct from P=int32_t.
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/pad.h **** template <typename T, typename P>
