  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/runtime_shape.h ****   // RuntimeShape in TFLM supports up to 6 dimensions.
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/runtime_shape.h ****   // The name kMaxSmallSize comes from the same file of the upstream
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/runtime_shape.h ****   // tensorflow lite repo and need to be kept the same for max reuse.
