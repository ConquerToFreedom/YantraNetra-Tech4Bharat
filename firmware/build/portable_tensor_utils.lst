 536:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 537:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Tweaking IntegerBits gives exact multiplication by a power of two.
 538:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int tExponent, typename tRawType, int tIntegerBits>
 539:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tExponent + tIntegerBits> ExactMulByPot(
 540:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, tIntegerBits> a) {
 541:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   FixedPoint<tRawType, tExponent + tIntegerBits> c;
 542:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   c.raw() = a.raw();
 543:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return c;
 544:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 545:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 546:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // If we want to leave IntegerBits fixed, then multiplication
 547:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // by a power of two has to be saturating/rounding, not exact anymore.
 548:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int tExponent, typename tRawType, int tIntegerBits>
 549:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tIntegerBits> SaturatingRoundingMultiplyByPOT(
 550:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, tIntegerBits> a) {
 551:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return FixedPoint<tRawType, tIntegerBits>::FromRaw(
 552:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****       SaturatingRoundingMultiplyByPOT<tExponent>(a.raw()));
 553:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
