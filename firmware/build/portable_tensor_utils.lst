 561:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     return FixedPoint<tRawType, tIntegerBits>::FromRaw(ImplFuncName(a.raw())); \
 562:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   }
 563:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
