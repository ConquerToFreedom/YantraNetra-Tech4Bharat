 516:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Use the same LUT generation code for both uint8_t and int8_t. Int8_t indexes
 517:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // will be directly casted to uint8_t, the int8 LUT will thus be ordered as [0,
 518:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // 1, ..., 127, -128, ..., -2, -1] instead of [-128, -127, ..., -1, 0, 1, ...,
 519:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // 126, 127].
 520:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T, typename Func>
 521:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline void LUTPopulateInt8(float input_scale, int32_t input_zero_point,
 522:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                             float output_scale, int32_t output_zero_point,
 523:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                             Func transform, const void* transform_params,
 524:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                             T* lut) {
 525:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   static_assert(
 526:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****       std::is_same<T, uint8_t>::value || std::is_same<T, int8_t>::value,
 527:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****       "T must be an uint8 or int8 type.");
 528:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   uint8_t* lut_uint8 = reinterpret_cast<uint8_t*>(lut);
 529:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   const float inverse_scale = 1 / output_scale;
 530:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   int32_t maxval = std::numeric_limits<T>::max();
 531:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   int32_t minval = std::numeric_limits<T>::min();
 532:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   for (int32_t val = minval; val <= maxval; ++val) {
 533:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     const float dequantized = input_scale * (val - input_zero_point);
 534:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     const float transformed =
 535:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         LUTTransform(transform, transform_params, dequantized);
 536:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     const float rescaled = TfLiteRound(transformed * inverse_scale);
 537:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     const int32_t quantized =
 538:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         static_cast<int32_t>(rescaled + output_zero_point);
 539:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     lut_uint8[static_cast<uint8_t>(static_cast<T>(val))] = static_cast<uint8_t>(
 540:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         static_cast<T>(std::max(std::min(maxval, quantized), minval)));
 541:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
 542:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
