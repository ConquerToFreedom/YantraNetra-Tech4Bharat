1089:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Given the dimensions of the operands for an element-wise binary broadcast,
1090:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // adjusts them so that they can be directly iterated over with simple loops.
1091:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Returns the adjusted dims as instances of NdArrayDesc in 'desc0_out' and
1092:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // 'desc1_out'. 'desc0_out' and 'desc1_out' cannot be nullptr.
1093:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
1094:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // This function assumes that the two input shapes are compatible up to
1095:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // broadcasting and the shorter one has already been prepended with 1s to be the
1096:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // same length. E.g., if shape0 is (1, 16, 16, 64) and shape1 is (1, 64),
1097:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // shape1 must already have been prepended to be (1, 1, 1, 64). Recall that
1098:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Dims<N> refer to shapes in reverse order. In this case, input0_dims will be
1099:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // (64, 16, 16, 1) and input1_dims will be (64, 1, 1, 1).
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\ccVtfajx.s 			page 55


1100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
1101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // When two shapes are compatible up to broadcasting, for each dimension d,
1102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // the input extents are either equal, or one of them is 1.
1103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
1104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // This function performs the following for each dimension d:
1105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // - If the extents are equal, then do nothing since the loop that walks over
1106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //   both of the input arrays is correct.
1107:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // - Otherwise, one (and only one) of the extents must be 1. Say extent0 is 1
1108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //   and extent1 is e1. Then set extent0 to e1 and stride0 *to 0*. This allows
1109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //   array0 to be referenced *at any index* in dimension d and still access the
1110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //   same slice.
1111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <int N>
1112:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline void NdArrayDescsForElementwiseBroadcast(const Dims<N>& input0_dims,
1113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                                 const Dims<N>& input1_dims,
1114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                                 NdArrayDesc<N>* desc0_out,
1115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                                 NdArrayDesc<N>* desc1_out) {
1116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   TFLITE_DCHECK(desc0_out != nullptr);
1117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   TFLITE_DCHECK(desc1_out != nullptr);
1118:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
1119:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // Copy dims to desc.
1120:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   for (int i = 0; i < N; ++i) {
1121:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     desc0_out->extents[i] = input0_dims.sizes[i];
1122:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     desc0_out->strides[i] = input0_dims.strides[i];
1123:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     desc1_out->extents[i] = input1_dims.sizes[i];
1124:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     desc1_out->strides[i] = input1_dims.strides[i];
1125:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
1126:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
1127:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // Walk over each dimension. If the extents are equal do nothing.
1128:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // Otherwise, set the desc with extent 1 to have extent equal to the other and
1129:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // stride 0.
1130:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   for (int i = 0; i < N; ++i) {
1131:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     const int extent0 = ArraySize(input0_dims, i);
1132:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     const int extent1 = ArraySize(input1_dims, i);
1133:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     if (extent0 != extent1) {
1134:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****       if (extent0 == 1) {
1135:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         desc0_out->strides[i] = 0;
1136:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         desc0_out->extents[i] = extent1;
1137:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****       } else {
1138:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         TFLITE_DCHECK_EQ(extent1, 1);
1139:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         desc1_out->strides[i] = 0;
1140:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****         desc1_out->extents[i] = extent0;
1141:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****       }
1142:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     }
1143:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
1144:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
