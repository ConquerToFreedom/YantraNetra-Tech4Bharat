1044:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // NdArrayDesc<N> describes the shape and memory layout of an N-dimensional
1045:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // rectangular array of numbers.
1046:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
1047:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // NdArrayDesc<N> is basically identical to Dims<N> defined in types.h.
1048:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // However, as Dims<N> is to be deprecated, this class exists as an adaptor
1049:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // to enable simple unoptimized implementations of element-wise broadcasting
1050:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // operations.
1051:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <int N>
1052:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** struct NdArrayDesc {
1053:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // The "extent" of each dimension. Indices along dimension d must be in the
1054:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // half-open interval [0, extents[d]).
1055:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   int64_t extents[N];
1056:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
1057:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // The number of *elements* (not bytes) between consecutive indices of each
1058:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   // dimension.
1059:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   int64_t strides[N];
1060:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** };
