  30:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // Double-precision binary64 floating point format is:
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // Bit |  63  |  62-52   |   51-0   |
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** //     | Sign | Exponent | Fraction |
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // To avoid 64-bit integers as much as possible, I break this into high and
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // low 32-bit chunks. High is:
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // Bit |  31  |  30-20   |      19-0     |
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** //     | Sign | Exponent | High Fraction |
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // Low is:
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // Bit |     31-0     |
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** //     | Low Fraction |
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // We then access the components through logical bit-wise operations to
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // extract the parts needed, with the positions and masks derived from the
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** // layout shown above.
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint64_t kSignMask = 0x8000000000000000LL;
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint64_t kExponentMask = 0x7ff0000000000000LL;
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr int32_t kExponentShift = 52;
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr int32_t kExponentBias = 1023;
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint32_t kExponentIsBadNum = 0x7ff;
  48:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint64_t kFractionMask = 0x000fffffffc00000LL;
  49:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint32_t kFractionShift = 22;
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint32_t kFractionRoundingMask = 0x003fffff;
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** constexpr uint32_t kFractionRoundingThreshold = 0x00200000;
  52:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc **** }  // namespace
