  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   TFLITE_CHECK_LE(q_fixed, std::numeric_limits<int32_t>::max());
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   // A shift amount smaller than -31 would cause all bits to be shifted out
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   // and thus all results would be zero. We implement that instead with
