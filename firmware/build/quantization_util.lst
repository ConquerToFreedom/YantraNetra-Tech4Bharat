  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   const double q = std::frexp(double_multiplier, shift);
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   auto q_fixed = static_cast<int64_t>(TfLiteRound(q * (1LL << 31)));
