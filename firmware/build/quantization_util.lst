  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   TFLITE_CHECK(q_fixed <= (1LL << 31));
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****   if (q_fixed == (1LL << 31)) {
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/quantization_util.cc ****     q_fixed /= 2;
