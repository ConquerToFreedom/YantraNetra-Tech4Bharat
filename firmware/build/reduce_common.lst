 164:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** inline bool ResolveAxis(const int num_dims, const int* axis,
 165:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                         const int64_t num_axis, int* out_axis,
