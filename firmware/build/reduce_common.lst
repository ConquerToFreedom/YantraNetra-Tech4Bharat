 132:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** // The 'reducer_first' is called with the first value of the reduction,
 133:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** // 'reducer_next' is then called for all the others.
 134:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** template <typename In, typename Out>
 135:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** inline bool Reduce(const In* input_data, const int* input_dims,
 136:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                    const int* output_dims, const int input_num_dims,
 137:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                    const int output_num_dims, const int* axis,
