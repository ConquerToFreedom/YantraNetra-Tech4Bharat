  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Well-defined wrapping integer arithmetic helpers.
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Several elementwise/reduction kernels intentionally allow their value
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // arithmetic to wrap around for narrow integer types (the result is later
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // clamped, or wrapping is the documented behavior). Performing that wrap
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // directly on signed types is Undefined Behavior in C++, which the optimizer is
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // free to miscompile. These helpers instead perform the arithmetic in the
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // corresponding unsigned type -- where wrapping is fully defined -- and convert
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // the result back, so there is no UB even in optimized release builds.
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // For floating-point T these are plain a+b / a*b (no overflow concern); the
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // unsigned path is only taken for integral types.
  48:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** //
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\cc2dcVBE.s 			page 19


  49:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Note on integral promotion: for integer types narrower than int (e.g.
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // int16_t), the corresponding unsigned type (uint16_t) is still promoted to the
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // signed `int` before the arithmetic is performed. That promotion would
  52:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // reintroduce signed overflow UB (e.g. 65535 * 65535 overflows int). To avoid
  53:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // it we widen the operands to an unsigned type at least as wide as unsigned int
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // so the arithmetic itself stays unsigned, then truncate back down to the
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // narrow type -- both steps are well-defined.
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
  57:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline T WrappingAdd(T a, T b) {
  58:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   if constexpr (std::is_integral_v<T> && !std::is_same_v<T, bool>) {
  59:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     using U = std::make_unsigned_t<T>;
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     using P = std::common_type_t<U, unsigned int>;
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return static_cast<T>(static_cast<U>(static_cast<P>(static_cast<U>(a)) +
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                          static_cast<P>(static_cast<U>(b))));
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   } else {
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return a + b;
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
  66:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
  67:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
  68:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
  69:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** inline T WrappingMul(T a, T b) {
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   if constexpr (std::is_integral_v<T> && !std::is_same_v<T, bool>) {
  71:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     using U = std::make_unsigned_t<T>;
  72:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     using P = std::common_type_t<U, unsigned int>;
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return static_cast<T>(static_cast<U>(static_cast<P>(static_cast<U>(a)) *
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                          static_cast<P>(static_cast<U>(b))));
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   } else {
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****     return a * b;
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   }
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** }
  79:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** 
  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Tensor value arithmetic helpers for ops where integer overflow is documented
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // numeric behavior and not used for memory allocation, indexing, shape
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // computation, or control-flow bounds. These intentionally preserve the direct
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // arithmetic expression and only suppress UBSan's integer-overflow diagnostic.
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Do not use these helpers for shape, element count, allocation, or pointer
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // offset arithmetic; those paths need checked integer helpers instead.
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <typename T>
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** TFLITE_NO_SANITIZE_INTEGER_OVERFLOW inline T
