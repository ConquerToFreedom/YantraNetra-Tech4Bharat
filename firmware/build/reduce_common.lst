 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** // A generic reduce method that can be used for reduce_sum, reduce_mean, etc.
 107:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** // This method iterates through input data and reduce elements along the
 108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** // dimensions given in axis.
 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** template <typename In, typename Out>
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h **** inline bool Reduce(const In* input_data, const int* input_dims,
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                    const int* output_dims, const int input_num_dims,
 112:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                    const int output_num_dims, const int* axis,
 113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                    const int num_axis, int* input_iter,
 114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****                    Out reducer(Out current, const In in), Out* output_data) {
 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****   // Reset input iterator.
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****   for (int idx = 0; idx < input_num_dims; ++idx) {
 117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****     input_iter[idx] = 0;
 118:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****   }
 119:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****   // Iterate through input_data.
 120:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****   do {
 121:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****     size_t input_offset =
 122:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****         ReducedOutputOffset(input_num_dims, input_dims, input_iter, 0, nullptr);
 123:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/reduce.h ****     size_t output_offset = ReducedOutputOffset(input_num_dims, input_dims,
