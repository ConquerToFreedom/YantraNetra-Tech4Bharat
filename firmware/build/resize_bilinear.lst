 258:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // Get common array size, DCHECKing that they all agree.
 259:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** template <typename ArrayType1, typename ArrayType2>
 260:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** int MatchingArraySize(const ArrayType1& array1, int index1,
 261:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****                       const ArrayType2& array2, int index2) {
 262:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   TFLITE_DCHECK_EQ(ArraySize(array1, index1), ArraySize(array2, index2));
