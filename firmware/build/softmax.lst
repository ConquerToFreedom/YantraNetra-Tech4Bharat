 689:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   assert(result == FixedPointType::FromDouble(double_value));
 690:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return result;
 691:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
