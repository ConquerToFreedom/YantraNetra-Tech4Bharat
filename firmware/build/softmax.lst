  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Reduces and compresses dimensions so that broadcast handling becomes more
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // efficient. Returns true if the output shape is broadcastable; it doesn't
 100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // contain any degenerate dimension, i.e. shape dimension = 0. False otherwise.
 101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** template <int MAX_DIM = 6>
 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** bool ReduceDimensionsForBroadcast(const RuntimeShape& input1_shape,
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                   const RuntimeShape& input2_shape,
 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                   size_t* compressed_input1_stride,
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                   size_t* compressed_input2_stride,
 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****                                   size_t* compressed_output_shape) {
 107:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   size_t num_compressed_dims = 0;
 108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   size_t compressed_input1_shape[MAX_DIM];
 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   size_t compressed_input2_shape[MAX_DIM];
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   std::fill(compressed_input1_shape, compressed_input1_shape + MAX_DIM, 1);
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   std::fill(compressed_input2_shape, compressed_input2_shape + MAX_DIM, 1);
 112:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   std::fill(compressed_output_shape, compressed_output_shape + MAX_DIM, 1);
 113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   bool broadcast_input1 = false;
 114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   bool broadcast_input2 = false;
 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   bool first_nonunit = true;
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   const size_t num_input1_dims = input1_shape.DimensionsCount();
 117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h ****   const size_t num_input2_dims = input2_shape.DimensionsCount();
