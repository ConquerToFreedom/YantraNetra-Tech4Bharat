 526:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // raw integer values. The IntegerBits simply add up, as is obvious
 527:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // from the fact that the range is [-2^IntegerBits, 2^IntegerBits).
 528:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType, int tIntegerBits_a, int tIntegerBits_b>
 529:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tIntegerBits_a + tIntegerBits_b> operator*(
