  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType Mul(tIntegerType a, tIntegerType b) {
