 532:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   FixedPoint<tRawType, tIntegerBits_a + tIntegerBits_b> c;
 533:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   c.raw() = SaturatingRoundingDoublingHighMul(a.raw(), b.raw());
 534:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return c;
 535:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
