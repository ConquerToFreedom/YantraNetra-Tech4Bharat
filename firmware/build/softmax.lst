  53:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** };
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <>
