 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Integer subtraction. Not saturating. Overflow is undefined behavior.
 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tIntegerType>
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** tIntegerType Sub(tIntegerType a, tIntegerType b) {
