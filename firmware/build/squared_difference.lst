  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     return stride == 0;
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   } else {
