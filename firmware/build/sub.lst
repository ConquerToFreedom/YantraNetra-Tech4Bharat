  72:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h **** // Returns true if a dimension of a loop nest can be fused with the previous
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h **** // dimension in the loop nest.
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h **** inline bool CanFuseLoops(size_t output_dim, size_t dim, size_t stride,
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****                          size_t expected_stride, size_t next_stride) {
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   if (output_dim == 1) {
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     // We can always fuse an extent 1 dimension.
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     return true;
  79:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   }
  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   if (next_stride == 0) {
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     // The next loop's stride is 0, the current stride must be 0 too.
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     return stride == 0;
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   } else {
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     // The next loop's stride must match the current loop's stride.
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****     return stride == expected_stride;
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h ****   }
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/broadcast_loop.h **** }
