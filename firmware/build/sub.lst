 209:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Returns true if all of the input scalars are nonzero.
 210:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // This function may currently assume that each of the input scalars has either
