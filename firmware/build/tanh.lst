 346:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   std::int32_t ab_32 = a_32 * b_32;
 347:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   std::int16_t nudge = ab_32 >= 0 ? (1 << 14) : (1 - (1 << 14));
 348:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   std::int16_t ab_x2_high16 =
