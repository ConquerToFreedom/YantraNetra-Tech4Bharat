 685:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename FixedPointType>
 686:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPointType CheckedFixedPointConstant(std::int32_t raw_value,
 687:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****                                          double double_value) {
 688:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   const FixedPointType result = FixedPointType::FromScalarRaw(raw_value);
