 383:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 384:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int Exponent, typename IntegerType>
 385:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct ImplSaturatingRoundingMultiplyByPOT<Exponent, IntegerType, 1> {
 386:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static IntegerType eval(IntegerType x) {
 387:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     using ScalarIntegerType =
 388:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         typename FixedPointRawTypeTraits<IntegerType>::ScalarRawType;
 389:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     const IntegerType min =
 390:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         Dup<IntegerType>(std::numeric_limits<ScalarIntegerType>::min());
 391:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     const IntegerType max =
 392:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         Dup<IntegerType>(std::numeric_limits<ScalarIntegerType>::max());
 393:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     const int ScalarIntegerTypeBits = 8 * sizeof(ScalarIntegerType);
 394:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 395:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     const std::int32_t threshold =
 396:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         ((1 << (ScalarIntegerTypeBits - 1 - Exponent)) - 1);
 397:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     const IntegerType positive_mask =
 398:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         MaskIfGreaterThan(x, Dup<IntegerType>(threshold));
 399:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     const IntegerType negative_mask =
 400:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****         MaskIfLessThan(x, Dup<IntegerType>(-threshold));
 401:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 402:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     IntegerType result = ShiftLeft(x, Exponent);
 403:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     result = SelectUsingMask(positive_mask, max, result);
 404:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     result = SelectUsingMask(negative_mask, min, result);
 405:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     return result;
 406:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   }
 407:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** };
