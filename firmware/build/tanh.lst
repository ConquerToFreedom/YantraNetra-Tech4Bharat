 143:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   double scale = 0.0;
 144:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** };
 145:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** 
 146:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** inline bool operator==(const QuantizationParams& qp1,
