 416:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int Exponent, typename IntegerType>
 417:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** IntegerType SaturatingRoundingMultiplyByPOT(IntegerType x) {
 418:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return ImplSaturatingRoundingMultiplyByPOT<Exponent, IntegerType>::eval(x);
