 409:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int Exponent, typename IntegerType>
 410:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** struct ImplSaturatingRoundingMultiplyByPOT<Exponent, IntegerType, -1> {
 411:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static IntegerType eval(IntegerType x) {
