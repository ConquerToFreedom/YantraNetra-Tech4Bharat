 341:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** inline std::int16_t SaturatingRoundingDoublingHighMul(std::int16_t a,
 342:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****                                                       std::int16_t b) {
 343:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   bool overflow = a == b && a == std::numeric_limits<std::int16_t>::min();
 344:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   std::int32_t a_32(a);
