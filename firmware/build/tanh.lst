 666:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // CheckedFixedPointConstant allows to specify fixed-point constants
 667:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // initialized as real numbers, in a way that does not compile floating-point
