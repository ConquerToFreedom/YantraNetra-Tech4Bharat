 545:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 546:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // If we want to leave IntegerBits fixed, then multiplication
