 669:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // floating-point expressions when asserts are enabled.
 670:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 671:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // The raw integer value provided is always a int32, encoding a 32-bit
 672:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // fixed-point value, regardless of the actual Scalar type. This allows
 673:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // writing generic code that applies just as well to the 32-bit and 16-bit
 674:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // cases. In the 16-bit case, the raw integer value is internally
 675:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // rounding-shifted by 16 bits to the right.
 676:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename FixedPointType>
