 421:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Part 2: the FixedPoint class.
 422:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 423:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // A FixedPoint object represents a fixed-point value stored in the underlying
 424:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // integer type tRawType.
 425:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 426:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // tIntegerBits describes the range of the fixed-point format: if
 427:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // tIntegerBits == m then the range of representable values is the half-open
 428:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // interval [-2^m; 2^m) where the open boundary on the right side means that
 429:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // 2^m is not representable (how close the maximum representable value is to
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\ccWPtBmb.s 			page 85


 430:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // it, depends on bit-depth of tRawType).
 431:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 432:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // In "Q format notation",
 433:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   https://en.wikipedia.org/wiki/Q_(number_format)
 434:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // we are describing the format
 435:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   Qm.n
 436:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // where
 437:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   m = tIntegerBits
 438:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // and
 439:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //   n = NumberOfBits(tRawType) - (m + 1)
 440:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Note that the (m + 1) in the above line is because we adopt the convention
 441:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // that we count the integer bits exclusively of the sign bit; so (m + 1) is
 442:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // the total number of integer bits inclusive of the sign bit.
 443:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** //
 444:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Accordingly, the number of integral representable values in our range
