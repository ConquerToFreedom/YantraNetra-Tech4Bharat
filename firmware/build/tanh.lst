 522:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // FixedPoint class, and a few related functions.
 523:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 524:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // A FixedPoint multiplication is just a
 525:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // SaturatingRoundingDoublingHighMul operation on the underlying
 526:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // raw integer values. The IntegerBits simply add up, as is obvious
 527:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // from the fact that the range is [-2^IntegerBits, 2^IntegerBits).
 528:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <typename tRawType, int tIntegerBits_a, int tIntegerBits_b>
 529:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tIntegerBits_a + tIntegerBits_b> operator*(
 530:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, tIntegerBits_a> a,
 531:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****     FixedPoint<tRawType, tIntegerBits_b> b) {
 532:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   FixedPoint<tRawType, tIntegerBits_a + tIntegerBits_b> c;
 533:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   c.raw() = SaturatingRoundingDoublingHighMul(a.raw(), b.raw());
 534:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return c;
 535:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
 536:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** 
 537:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** // Tweaking IntegerBits gives exact multiplication by a power of two.
 538:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** template <int tExponent, typename tRawType, int tIntegerBits>
 539:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** FixedPoint<tRawType, tExponent + tIntegerBits> ExactMulByPot(
