 679:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   typedef typename FixedPointType::ScalarRawType ScalarRawType;
 680:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   static constexpr int ScalarTypeBits = 8 * sizeof(ScalarRawType);
 681:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****   return static_cast<ScalarRawType>(
 682:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h ****       RoundingDivideByPOT<std::int32_t>(int32_value, 32 - ScalarTypeBits));
 683:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/fixedpoint.h **** }
