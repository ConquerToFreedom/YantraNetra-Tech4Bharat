 143:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Sets up the stride arrays for the recursive transpose algorithm.
 144:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
 145:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Implementation notes:
 146:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
 147:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // This is a reverse partial product. We could use standard algorithms to
 148:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // implement this but the result is not a readable and is tricky to get right
 149:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // because the first element must be set to 1, which leads to offset
 150:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // shenanigans:
 151:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
 152:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
 153:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   stride[dims - 1] = 1;
 154:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   std::partial_sum(std::make_reverse_iterator(shape + dims),
 155:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //                    std::make_reverse_iterator(shape + 1),
 156:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //                    stride.rend() - input_rank + 1, std::multiplies());
 157:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
 158:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
 159:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Note that Abseil isn't used in kernels implementation. That would make the
 160:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // above solution more readable.
 161:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** inline void SetupTransposeStrides(
 162:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     std::array<int, kTransposeMaxDimensions>& stride, const int32_t* shape,
 163:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     const int dims) {
