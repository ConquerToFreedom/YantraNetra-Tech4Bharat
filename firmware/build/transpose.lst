  29:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Recursively explores all the dimensions of the output tensor and writes the
  30:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // corresponding input tensor data.
  31:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  32:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - depth: the current depth of the recursion.
  33:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - dims: tensor dimension count, also `perm` size.
  34:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - perm: permutation array.
  35:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - input_data: Running input data pointer. If depth == num_dims-1, this points
  36:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //               to the first element of the last dimension to traverse.
  37:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - input_stride: Reverse partial product of input shapes.
  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - output_data: Running output data pointer. If depth == num_dims-1, this
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //                points to the first element of the last dimension to traverse.
  40:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - output_stride: Reverse partial product of output shapes.
  41:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // - output_shape: Shape of the output tensor.
  42:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  43:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ## Algorithm explanation
  44:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  45:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // Assume a 3D tensor T with a shape of [I, J, K] stored in row major order.
  46:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // T[i, j, k] is at position `i*J*K + j*K + k` in the tensor buffer.
  47:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  48:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // If we want to go through the whole tensor iteratively, we can use loops.
  49:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  50:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  51:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // for(i = 0; i < I; ++i) {
  52:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   for(j = 0; j < J; ++j) {
  53:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     for(k = 0; k < K; ++k) {
  54:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //        T.data[i*J*K + j*K + k] = ...
  55:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     }
  56:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   }
  57:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // }
  58:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  59:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  60:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // We can also compute the offset as we go through the loops.
  61:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  62:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  63:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // stride_i = K * J;
  64:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // stride_j = K;
  65:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // stride_k = 1;
  66:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // for(i = 0; i < I; ++i) {
  67:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   offset_i = i * stride_i;
  68:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   offset_j = 0;
  69:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   for(j = 0; j < J; ++j) {
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     offset_j += stride_j;
  71:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     offset_k = 0;
  72:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     for(k = 0; k < K; ++k) {
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //        offset_k += stride_k;
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //        T.data[offset_i + offset_j + offset_k] = ...
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     }
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   }
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // }
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  79:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // This nicely extends to a recursive version which is the base of this
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // algorithm and supports any number of dimensions.
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // shape = [I, J, K]
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // strides = [K*J, K, 1]
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\ccX57r4k.s 			page 3


  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // void recurse(T* data, shape, strides, depth = 0) {
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   if(depth == shape.size) {
