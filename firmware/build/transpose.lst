  91:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //       recurse(data, shape, strides, depth+1);
  92:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //       data += strides[depth];
  93:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //     }
  94:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** //   }
  95:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // }
  96:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** // ```
  97:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** template <typename T>
  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** void TransposeImpl(const int depth, const int dims, const int32_t* perm,
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****                    const T* input_data, const int* input_stride, T* output_data,
 100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****                    const int* output_stride, const int32_t* output_shape) {
 101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****   const int dimension_size = output_shape[depth];
 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****   if (depth == dims - 1) {
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     const int loop_stride = input_stride[perm[depth]];
 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     for (int i = 0; i < dimension_size; ++i) {
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****       output_data[i] = *input_data;
 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****       input_data += loop_stride;
 107:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     }
 108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****   } else {
 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     for (int i = 0; i < dimension_size; ++i) {
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****       TransposeImpl(depth + 1, dims, perm, input_data, input_stride,
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****                     output_data, output_stride, output_shape);
 112:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h **** 
 113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****       input_data += input_stride[perm[depth]];
 114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****       output_data += output_stride[depth];
 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/reference/transpose.h ****     }
