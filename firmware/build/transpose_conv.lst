  69:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // This enumeration allows for non-default formats for the weights array
  70:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // of a fully-connected operator, allowing the use of special optimized
  71:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** // runtime paths.
  72:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** enum class FullyConnectedWeightsFormat : uint8_t {
  73:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // Default format (flat 2D layout, the inner contiguous dimension
  74:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // is input_depth, the outer non-contiguous dimension is output_depth)
  75:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   kDefault,
  76:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // Summary: optimized layout for fast CPU runtime implementation,
  77:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // aimed specifically at ARM CPUs at the moment, and specialized for
  78:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // 8-bit quantized layers.
  79:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
  80:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // The use case we're concerned with here is: 8-bit quantization,
  81:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // large weights matrix that doesn't fit in cache (e.g. 4096x2048 in
  82:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // a key application that drove this), very small batch size (e.g. 1 -- 4).
  83:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
  84:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // Even with 8-bit quantization of weights, the performance of memory
  85:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // accesses to the weights can become the dominant issue when
  86:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // the batch size is small, so each weight value is used in only a few
  87:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // arithmetic ops, i.e. the fully-connected node has a low arithmetic
  88:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // intensity. The specific issues that arise are of three kinds:
  89:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // (1) One may, ideally, max out DRAM bandwidth, i.e. be truly memory
  90:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     bound. That's the "good" issue to run into.
  91:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // (2) One may run into sub-optimal pre-fetching: the data hasn't been
  92:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     prefetched into the cache by the time we need it.
  93:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // (3) One may run into cache aliasing: multiple values that are
  94:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     pre-fetched, alias each other in the L1 cache (which typically
  95:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     has only 4-way set associativity in ARM CPUs) and thus evict
  96:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     each other before we get to using them.
  97:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
  98:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // The point of this shuffling is to avoid issues (2) and (3) so that
  99:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // we get as fast as possible given only the hard constraint (1).
 100:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // This is achieved by turning the difficulty into a solution: the
 101:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // difficulty, that each value loaded from memory is used only in
 102:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // one kernel iteration, making this operation memory-intensive, hints at
 103:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // the solution, of shuffling the weights so that they are stored in the
ARM GAS  C:\Users\Chetan\AppData\Local\Temp\ccL5eRZU.s 			page 19


 104:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // exact order as the kernel needs to load them, so that the memory
 105:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // accesses made by the kernel are trivial. This solves (2) because the
 106:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // trivial memory access pattern allows the CPU's automatic prefetching
 107:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // to perform very well (no need even for preload instructions), and this
 108:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // solves (3) because the values being loaded concurrently are now
 109:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // contiguous in the address space, thus don't alias each other in the cache.
 110:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
 111:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // On ARM, we typically want our kernel to process a 4x16 block of weights
 112:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // at a time, because:
 113:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //   - 16 is the number of bytes in a NEON register.
 114:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //   - 4 is how many rows we need to handle concurrently in the kernel in
 115:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     order to have sufficient mutual independence of instructions to
 116:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //     maximize arithmetic throughput.
 117:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
 118:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // Finally, the 'Int8' part in the name refers to the fact that this
 119:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // weights format has each weights value encoded as a signed int8_t value,
 120:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // even if the data type of the weights buffer is uint8_t.  This is intended
 121:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // to save runtime kernels the effort to have to XOR the top bit of these
 122:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // bytes before using them in signed arithmetic, see this file for more
 123:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   // explanations on the 'signed int8_t trick' in matrix multiplication kernels:
 124:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
 125:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //   tensorflow/lite/toco/graph_transformations/ensure_uint8_weights_safe_for_fast_int8_kernels.c
 126:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   //
 127:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h ****   kShuffled4x16Int8,
 128:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/types.h **** };
