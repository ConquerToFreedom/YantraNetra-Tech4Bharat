  38:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // Several elementwise/reduction kernels intentionally allow their value
  39:lib/tflite-micro/tensorflow/lite/micro/kernels/internal/common.h **** // arithmetic to wrap around for narrow integer types (the result is later
