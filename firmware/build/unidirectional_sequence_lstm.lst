 264:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     // Scratch arrays
 265:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     CellType* fc_output_buffer, const TfLiteFusedActivation activation) {
 266:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****   const auto gate_output_shape = step_info.StateShape();
