 257:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     const TfLiteEvalTensor* input, const TfLiteEvalTensor* input_weight,
 258:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     const TfLiteEvalTensor* input_bias,
 259:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     // Recurrent FC
 260:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     const TfLiteEvalTensor* recurrent, const TfLiteEvalTensor* recurrent_weight,
 261:lib/tflite-micro/tensorflow/lite/micro/kernels/lstm_eval.h ****     const TfLiteEvalTensor* recurrent_bias,
